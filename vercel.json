{
    "buildCommand": "vite build",
    "outputDirectory": "dist",
    "installCommand": "npm install",
    "crons": [
        {
            "path": "/api/cron/sync",
            "schedule": "*/30 * * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/index.ts"
        },
        {
            "source": "/sitemap:path*",
            "destination": "/api/index.ts"
        },
        {
            "source": "/:path*",
            "destination": "/index.html"
        }
    ]
}
