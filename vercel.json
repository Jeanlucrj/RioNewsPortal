{
    "outputDirectory": "dist",
    "functions": {
        "api/index.ts": {
            "maxDuration": 60,
            "includeFiles": "dist/index.html"
        }
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/index.ts"
        },
        {
            "source": "/sitemap:path*",
            "destination": "/api/index.ts"
        },
        {
            "source": "/noticia/:path*",
            "destination": "/api/index.ts"
        },
        {
            "source": "/:path*",
            "destination": "/index.html"
        }
    ]
}
